# copie para .env
PGHOST=localhost
PGPORT=5432
PGDATABASE=frota
PGUSER=frota
PGPASSWORD=frota

# mês padrão dos comandos sem --mes
SENATRAN_MES=abril_2026

# 1 = usa a amostra de data/samples (75 mil linhas) em vez do dump real
USE_SAMPLE=1

# Spark (padrão local[*]); no Windows aponte HADOOP_HOME para o winutils
# SPARK_MASTER=local[4]
# HADOOP_HOME=C:\hadoop

# BigQuery (dbt --target bq e pipeline.load_bq)
# GCP_PROJECT=meu-projeto
# BQ_DATASET=analytics
# BQ_LOCATION=southamerica-east1

# Airflow: quando a DAG roda (cron)
# FROTA_CRON=0 6 15 * *
